{
  "_comment": "Aetheris Satisfactory egg - Pterodactyl-compatible (PTDL_v2).",
  "meta": {
    "version": "PTDL_v2",
    "update_url": "https://raw.githubusercontent.com/aetheris-project/aetheris-game-eggs/main/eggs/satisfactory/egg.json"
  },
  "exported_at": "2026-08-20T00:00:00+00:00",
  "name": "Satisfactory",
  "author": "aetheris-project",
  "description": "Satisfactory dedicated server via SteamCMD with experimental branch toggle, autosave interval and server password.",
  "features": [
    "pid_limit",
    "fs_write"
  ],
  "docker_images": {
    "ghcr.io/aetheris-project/satisfactory:latest": "SteamCMD - Satisfactory"
  },
  "file_denylist": [],
  "startup": "./start_server.sh -log -unattended -Port=${SERVER_PORT} -QueryPort=${QUERY_PORT} -BeaconPort=${BEACON_PORT} -multihome=0.0.0.0 -ServerPassword=\"${SERVER_PASSWORD}\" -AutoSaveInterval=${AUTOSAVE_INTERVAL}",
  "config": {
    "files": {},
    "startup": {
      "done": "Engine is initialized",
      "userInteraction": []
    },
    "stop": "quit",
    "logs": {
      "custom": true,
      "location": "logs/latest.log"
    },
    "extends": null
  },
  "scripts": {
    "installation": {
      "script": "# @author Aetheris Project\n# @description Satisfactory install script\n# @user-alpine\n\napt-get update -y\napt-get install -y curl\n\nmkdir -p /home/container/steamcmd /home/container/logs\ncd /home/container\n\nAPPID=1690800\nif [ \"${USE_EXPERIMENTAL}\" == \"1\" ]; then\n  APPID=1690801\nfi\n\ncurl -sSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar -xz -C steamcmd\n./steamcmd/steamcmd.sh +force_install_dir /home/container +login anonymous +app_update ${APPID} validate +quit\n\ncat > start_server.sh <<EOF\n#!/bin/bash\ncd /home/container\n./steamcmd/steamcmd.sh +force_install_dir /home/container +login anonymous +app_update ${APPID} validate +quit\nexec ./FactoryServer.sh \"$@\"\nEOF\nchmod +x start_server.sh",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Server Port",
      "description": "Game port.",
      "env_variable": "SERVER_PORT",
      "default_value": "7777",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:65535"
    },
    {
      "name": "Query Port",
      "description": "Query port (usually game port + 1).",
      "env_variable": "QUERY_PORT",
      "default_value": "7778",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:65535"
    },
    {
      "name": "Beacon Port",
      "description": "Beacon port (usually game port + 2).",
      "env_variable": "BEACON_PORT",
      "default_value": "7779",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:65535"
    },
    {
      "name": "Server Password",
      "description": "Password required to join (empty for none).",
      "env_variable": "SERVER_PASSWORD",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "string|max:64"
    },
    {
      "name": "Autosave Interval",
      "description": "Autosave interval in seconds.",
      "env_variable": "AUTOSAVE_INTERVAL",
      "default_value": "300",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:60|max:3600"
    },
    {
      "name": "Use Experimental",
      "description": "1 = experimental branch, 0 = stable.",
      "env_variable": "USE_EXPERIMENTAL",
      "default_value": "0",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|boolean"
    }
  ]
}
