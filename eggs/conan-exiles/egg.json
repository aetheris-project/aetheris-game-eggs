{
  "_comment": "Aetheris Conan Exiles egg - Pterodactyl-compatible (PTDL_v2).",
  "meta": {
    "version": "PTDL_v2",
    "update_url": "https://raw.githubusercontent.com/aetheris-project/aetheris-game-eggs/main/eggs/conan-exiles/egg.json"
  },
  "exported_at": "2026-08-20T00:00:00+00:00",
  "name": "Conan Exiles",
  "author": "aetheris-project",
  "description": "Conan Exiles dedicated server: open-world survival with base building, thralls and PvP or PvE conflicts.",
  "features": [
    "pid_limit",
    "fs_write"
  ],
  "docker_images": {
    "ghcr.io/aetheris-project/conan-exiles:latest": "Conan Exiles"
  },
  "file_denylist": [],
  "startup": "./ConanSandboxServer -log -Port=${SERVER_PORT} -QueryPort=${QUERY_PORT} -RconPort=${RCON_PORT} -RconPassword=\"${RCON_PASSWORD}\" -ServerName=\"${HOSTNAME}\" -MaxPlayers=${MAX_PLAYERS} -ServerPassword=\"${SERVER_PASSWORD}\"",
  "config": {
    "files": {},
    "startup": {
      "done": "Server started",
      "userInteraction": []
    },
    "stop": "quit",
    "logs": {
      "custom": false,
      "location": "logs/latest.log"
    },
    "extends": null
  },
  "scripts": {
    "installation": {
      "script": "# @author Aetheris Project\n# @description Conan Exiles dedicated server install via SteamCMD\n# @user-alpine\n\napt-get update -y\napt-get install -y curl tar\n\nmkdir -p /home/container/steamcmd\ncd /home/container\n\ncurl -sSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar -xz -C steamcmd\n./steamcmd/steamcmd.sh +force_install_dir /home/container +login anonymous +app_update 443030 validate +quit\n",
      "container": "ghcr.io/pterodactyl/installers:alpine",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Hostname",
      "description": "Server name shown in the server browser.",
      "env_variable": "HOSTNAME",
      "default_value": "Aetheris Conan Exiles",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:64"
    },
    {
      "name": "Server Port",
      "description": "Game port (UDP).",
      "env_variable": "SERVER_PORT",
      "default_value": "7777",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:65535"
    },
    {
      "name": "Query Port",
      "description": "Source query port used by the server browser.",
      "env_variable": "QUERY_PORT",
      "default_value": "27015",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:65535"
    },
    {
      "name": "RCON Port",
      "description": "RCON administration port.",
      "env_variable": "RCON_PORT",
      "default_value": "25575",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:65535"
    },
    {
      "name": "RCON Password",
      "description": "RCON password for remote administration.",
      "env_variable": "RCON_PASSWORD",
      "default_value": "changeme",
      "user_viewable": true,
      "user_editable": true,
      "rules": "string|max:64"
    },
    {
      "name": "Max Players",
      "description": "Maximum number of concurrent players.",
      "env_variable": "MAX_PLAYERS",
      "default_value": "40",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:500"
    },
    {
      "name": "Server Password",
      "description": "Password required to join (leave empty for a public server).",
      "env_variable": "SERVER_PASSWORD",
      "default_value": "",
      "user_viewable": true,
      "user_editable": true,
      "rules": "string|max:64"
    }
  ]
}
